  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "buildCommand": "node scripts/build-review.mjs",
  "outputDirectory": "review-dist",
  "framework": null
}
